# ──────────────────────────────────────────────────────
# EnglishCoach Pro — Environment Variables
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.

# ── Backend (FastAPI) ─────────────────────────────────
# Port for the FastAPI backend (default: 8000)
API_PORT=8000

# CORS allowed origins (comma-separated, no spaces)
# In development, use http://localhost:5173,http://localhost:4173
# In production, set to your actual frontend domain
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Desktop App (Optional) ────────────────────────────
# Machine ID override for encrypted API key storage
# Only needed if the Windows registry MachineGuid is unavailable
# ENGLISHCOACH_MACHINE_ID=

# ── Frontend (Vite / React) ──────────────────────────
# Copy web/.env.example to web/.env.local for frontend variables
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Edge Functions (set via Supabase Dashboard) ──
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
