# ──────────────────────────────────────────────────────
# EnglishCoach Pro — Environment Variables
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.

# ── Environment ──────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── Backend (FastAPI) ─────────────────────────────────
# Port for the FastAPI backend (default: 8000)
API_PORT=8000

# CORS allowed origins (comma-separated, no spaces)
# In development: http://localhost:5173,http://localhost:4173
# In production: set to your actual frontend domain(s) only
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000

# ── Supabase ──────────────────────────────────────────
# Project URL (safe to expose to frontend)
SUPABASE_URL=https://your-project.supabase.co

# Anon key (safe to expose to frontend — subject to RLS policies)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER-SIDE ONLY
# ⚠️  NEVER expose this to the frontend, browser, or API responses.
# ⚠️  NEVER commit this to Git. NEVER log it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── JWT ───────────────────────────────────────────────
# Supabase project JWT secret (used to validate Supabase-issued tokens)
# Found in: Supabase Dashboard → Settings → API → JWT Secret
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated

# ── Rate Limiting ──────────────────────────────────────
# Auth-sensitive endpoints (login, registration, etc.)
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Default rate limit for general API endpoints
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# ── Database ──────────────────────────────────────────
# Currently SQLite (local development). Future: PostgreSQL via Supabase.
# Leave empty to use the default local SQLite file.
# DATABASE_URL=sqlite:///./data.db

# ── Logging ───────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Desktop App (Optional) ────────────────────────────
# Machine ID override for encrypted API key storage
# Only needed if the Windows registry MachineGuid is unavailable
# ENGLISHCOACH_MACHINE_ID=

# ── Frontend (Vite / React) ──────────────────────────
# Copy web/.env.example to web/.env.local for frontend variables
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Edge Functions (set via Supabase Dashboard) ──
# ANTHROPIC_API_KEY=sk-ant-...
