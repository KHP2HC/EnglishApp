# EnglishCoach Pro — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.

# ── API Backend ──────────────────────────────────────
# URL of the FastAPI backend
# Local development: http://localhost:8000
# Production: https://your-api-domain.example
VITE_API_BASE_URL=http://localhost:8000

# ── Supabase (Auth) ──────────────────────────────────
# Project URL and anon key from Supabase dashboard
# Settings → API → Project URL, anon key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Notes ─────────────────────────────────────────────
# The following are SERVER-SIDE ONLY and must NEVER be in this file:
# - SUPABASE_SERVICE_ROLE_KEY
# - JWT_SECRET
# - ANTHROPIC_API_KEY
# - DATABASE_URL
